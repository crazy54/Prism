{
  "name": "prism-mcp-server",
  "version": "1.1.0",
  "description": "Production-grade MCP server exposing Prism's web, terminal and Prism Deck (Stream Deck / Corsair Galleon) catalogs: discovery, composition, facet creation, deck rendering, layouts, export and live key/knob editing.",
  "type": "module",
  "bin": {
    "prism-mcp": "./cli.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "start": "node cli.js start",
    "test": "node --test \"test/*.test.js\"",
    "sync:refraction": "node scripts/sync-refraction.mjs",
    "sync:refraction:check": "node scripts/sync-refraction.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prism",
    "catalog",
    "css",
    "components",
    "stream-deck",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {}
}
