<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet sources. We only restore Microsoft platform packs that the SDK references
  implicitly (Microsoft.NETCore.App.Runtime.win-x64 for self-contained publish,
  Microsoft.Windows.SDK.NET.Ref for the windows10.0.22621.0 TFM, Microsoft.NET.ILLink.Tasks
  when trimming). No third-party packages are referenced anywhere.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
