<Project Sdk="Microsoft.NET.Sdk">
  <!-- prismctl: validate (manifest + layouts against the vendored Elgato schemas), pack (.sdPlugin + .streamDeckPlugin),
       fake-host (run the plugin against the fake Stream Deck app). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PrismControl.Tools</RootNamespace>
    <AssemblyName>prismctl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.FakeHost\PrismControl.FakeHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="schemas\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="schemas" />
  </ItemGroup>
</Project>
