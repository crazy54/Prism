<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows module tests (W1 owns the switcher/display/placement tests; W2 adds System/Firmware/Clipboard/Capture tests).
       Run: dotnet run project tests/PrismControl.WinShell.Tests -artifacts-path <dir>   (two leading dashes each)
       Extra modes (after a double-dash separator): render-previews <dir>, write-icons <dir>, bench-thumbnails <seconds>.
       Every write path runs against fakes or the safe-mode writers. Integration tests only READ this PC; the only window
       they move is their own test window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.WinShell.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PrismUseDesktop Condition="'$(PrismUseDesktop)' == '' And Exists('..\..\src\PrismControl.Desktop\PrismControl.Desktop.csproj')">true</PrismUseDesktop>
    <PrismUseDesktop Condition="'$(PrismUseDesktop)' == ''">false</PrismUseDesktop>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PrismUseDesktop)' == 'true'">
    <DefineConstants>$(DefineConstants);PRISM_DESKTOP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.WinShell\PrismControl.WinShell.csproj" />
  </ItemGroup>
</Project>
