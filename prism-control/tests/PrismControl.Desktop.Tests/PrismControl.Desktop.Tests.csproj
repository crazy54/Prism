<Project Sdk="Microsoft.NET.Sdk">
  <!-- PrismControl.Desktop tests (owned by the Platform engineer). Run: dotnet run project tests/PrismControl.Desktop.Tests
       (with two leading dashes before "project"; append the runner option "exclude integration", dash-prefixed, for unit tests only).
       SAFETY: nothing here focuses, moves or changes another app's window, sends input, or changes a setting.
       Foreground and input paths run against scripted fakes. "integration" tests only READ the real desktop
       (enumerate windows, read icons) or use windows, pipes and files this test process created itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.Desktop.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.Desktop\PrismControl.Desktop.csproj" />
  </ItemGroup>
</Project>
