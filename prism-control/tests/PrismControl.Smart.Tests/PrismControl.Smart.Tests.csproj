<Project Sdk="Microsoft.NET.Sdk">
  <!-- Smart Deck engine tests (SD1). Run: dotnet run project tests/PrismControl.Smart.Tests (with an artifacts path), or the
       built exe from prism-control/. Previews: add "render-previews <dir>" with two leading dashes (see Program.cs).
       No test ever sends real input or focuses a window: Desktop's recording senders, fake foreground/Sight sources and
       temporary folders only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.Smart.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.Smart\PrismControl.Smart.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
