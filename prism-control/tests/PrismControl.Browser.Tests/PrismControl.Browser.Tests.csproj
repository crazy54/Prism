<Project Sdk="Microsoft.NET.Sdk">
  <!-- Browser module tests (owned by the Browser module engineer). Run: dotnet run project tests/PrismControl.Browser.Tests
       Every write path is faked: a recording command sink, fake foreground/input/shell ports, an in-memory registry and
       temp folders. The pipe tests use a real named pipe inside this process only. Nothing touches a browser, the
       registry or the user's input. Extra modes (two leading dashes): render-previews <dir>, write-icons <dir>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.Browser.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.Browser\PrismControl.Browser.csproj" />
  </ItemGroup>
</Project>
