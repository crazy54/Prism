<Project Sdk="Microsoft.NET.Sdk">
  <!-- Audio tests (owned by the Audio engineer). Run: dotnet run project tests/PrismControl.Audio.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.Audio.Tests</RootNamespace>
    <!-- NativeFakeCom.cs builds a native COM object by hand for the reference-count tests. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.Audio\PrismControl.Audio.csproj" />
  </ItemGroup>
</Project>
