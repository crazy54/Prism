<Project Sdk="Microsoft.NET.Sdk">
  <!-- SystemInfo tests (owned by the SystemInfo engineer). Run: dotnet run project tests/PrismControl.SystemInfo.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.SystemInfo.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- A real LibreHardwareMonitor data.json from the target PC (host name and GUIDs replaced with fictional ones). -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.SystemInfo\PrismControl.SystemInfo.csproj" />
  </ItemGroup>
</Project>
