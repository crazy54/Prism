<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ai module tests (engineer AI1). Run: dotnet run project tests/PrismControl.Ai.Tests (with an artifacts path).
       Previews: add "render-previews <dir>" with two leading dashes (see Program.cs).
       Every test uses fakes or temporary folders: no real hooks config, no focus, no input, no real agent CLI.
       The ingress tests open a real named pipe and talk to it from this test process only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PrismWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(PrismMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>PrismControl.Ai.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrismControl.Testing\PrismControl.Testing.csproj" />
    <ProjectReference Include="..\..\src\PrismControl.Ai\PrismControl.Ai.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Review L1: the shared scrubber's ONE case table, run here against the module's build of the shared scrubber. -->
    <Compile Include="..\PrismRelay.Tests\ScrubberCases.cs" Link="Shared\ScrubberCases.cs" />
  </ItemGroup>
</Project>
