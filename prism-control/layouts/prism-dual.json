    { "key": "bar_b", "type": "bar", "rect": [16, 68, 168, 12], "zOrder": 1, "value": 0, "range": { "min": 0, "max": 100 }, "subtype": 0, "border_w": 0, "bar_bg_c": "#171a25", "bar_fill_c": "#b8a2f2" }
