<Project Sdk="Microsoft.NET.Sdk">
  <!--
    prism-relay.exe: Chrome/Edge native-messaging host + agent hook relay (contract §2). Owned by the Platform engineer.
    Self-contained and small: NO reference to Core or Desktop, never referenced by the exe. tools/build.ps1 publishes it
    (at integration) and copies it into <plugin>/bin/.
    Publish (NativeAOT, needs the VC tools + Windows SDK for the link step):
      dotnet publish src/PrismRelay -c Release -r win-x64
    Fallback if NativeAOT cannot link: -p:PrismRelayAot=false (trimmed, uncompressed single file).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>prism-relay</AssemblyName>
    <RootNamespace>PrismRelay</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsAotCompatible>true</IsAotCompatible>
    <TieredPGO>false</TieredPGO>
    <AssemblyTitle>Prism Control relay</AssemblyTitle>
    <Description>Native-messaging host and agent hook relay for Prism Control</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PrismRelayAot)' != 'false'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PrismRelayAot)' == 'false'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrismRelay.Tests" />
  </ItemGroup>
</Project>
